# Java / Spring Boot
ITOPS_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/itops_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
ITOPS_MYSQL_USERNAME=root
ITOPS_MYSQL_PASSWORD=

ITOPS_RABBITMQ_HOST=127.0.0.1
ITOPS_RABBITMQ_PORT=5672
ITOPS_RABBITMQ_USERNAME=guest
ITOPS_RABBITMQ_PASSWORD=guest
ITOPS_RABBITMQ_VHOST=/

ITOPS_REDIS_HOST=127.0.0.1
ITOPS_REDIS_PORT=6379
ITOPS_REDIS_PASSWORD=
ITOPS_REDIS_DB=0

ITOPS_HARNESS_QUEUE_MODE=memory
ITOPS_HARNESS_LOCK_MODE=memory
ITOPS_HARNESS_IDEMPOTENCY_FAST_STORE=memory

# Python / Agent Runtime
ITOPS_MILVUS_URI=http://localhost:19530
ITOPS_MILVUS_COLLECTION=sop_catalog

ITOPS_EMBEDDING_PROVIDER=ollama
ITOPS_EMBEDDING_MODEL=bge-m3:latest
ITOPS_EMBEDDING_ENDPOINT=http://localhost:11434/v1
ITOPS_EMBEDDING_API_KEY=ollama

# ---------------------------------------------------------------------------
# Chat 模型配置（LLM）
# ---------------------------------------------------------------------------
# provider 可选值：
#   mock      —— 规则驱动的 Mock（默认，离线可运行）
#   deepseek  —— DeepSeek（https://api.deepseek.com，默认模型 deepseek-chat）
#   qwen      —— 通义千问（https://dashscope.aliyuncs.com/compatible-mode/v1，默认模型 qwen-plus）
#   glm       —— 智谱 GLM（https://open.bigmodel.cn/api/paas/v4，默认模型 glm-4-flash）
#   openai    —— OpenAI 官方（https://api.openai.com/v1，默认模型 gpt-4o-mini）
#

ITOPS_CHAT_PROVIDER=mock
ITOPS_CHAT_MODEL=
ITOPS_CHAT_ENDPOINT=
ITOPS_CHAT_API_KEY=

# DeepSeek 示例：
# ITOPS_CHAT_PROVIDER=deepseek
# ITOPS_CHAT_API_KEY=sk-your-deepseek-api-key
# ITOPS_CHAT_MODEL=deepseek-chat          # 可选，不设则用默认值

# Qwen示例：
# ITOPS_CHAT_PROVIDER=qwen
# ITOPS_CHAT_API_KEY=sk-your-qwen-api-key
# ITOPS_CHAT_MODEL=qwen-plus              # 可选，不设则用默认值

# GLM 示例：
# ITOPS_CHAT_PROVIDER=glm
# ITOPS_CHAT_API_KEY=your-glm-api-key
# ITOPS_CHAT_MODEL=glm-4-flash            # 可选，不设则用默认值
